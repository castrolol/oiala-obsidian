      "y": 655
    },
    {
      "color": "1",
      "height": 60,
      "id": "37bf4cbbbf599a67",
      "text": "- Árvore de Talentos 1",
      "type": "text",
      "width": 240,
      "x": -2877,
      "y": 230
    },
    {
      "height": 60,
